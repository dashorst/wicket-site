---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
}

const { title, date, tags = [] } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const tagColors: Record<string, string> = {
  release: 'bg-wicket-orange-glow text-wicket-orange',
  security: 'bg-[rgba(143,188,111,0.15)] text-[#5a8a3c]',
  community: 'bg-[rgba(109,179,206,0.15)] text-[#3a7a9a]',
};
---
<BaseLayout title={title}>
  <main class="bg-paper">
    <div class="max-w-3xl mx-auto px-6 md:px-12 py-16">
      <header class="mb-12">
        <div class="text-sm text-warm-light mb-2">{dateStr}</div>
        <div class="flex gap-2 mb-4">
          {tags.map(tag => (
            <span class:list={['text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded', tagColors[tag] || tagColors.community]}>
              {tag}
            </span>
          ))}
        </div>
        <h1 class="text-4xl font-bold text-ink">{title}</h1>
      </header>
      <div class="prose prose-warm max-w-none">
        <slot />
      </div>
    </div>
  </main>
</BaseLayout>
