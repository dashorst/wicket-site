---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  preamble?: string;
}

const { title, subtitle, preamble } = Astro.props;
---
<BaseLayout title={title}>
  <main class="bg-paper">
    <div class="max-w-4xl mx-auto px-6 md:px-12 py-16">
      <header class="mb-12">
        <h1 class="text-4xl font-bold text-ink">{title}</h1>
        {subtitle && <h2 class="text-xl text-wicket-orange font-light mt-2 font-display">{subtitle}</h2>}
        {preamble && <p class="text-warm-mid mt-4 leading-relaxed max-w-2xl">{preamble}</p>}
      </header>
      <div class="prose prose-warm max-w-none">
        <slot />
      </div>
    </div>
  </main>
</BaseLayout>
