---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { wicket } from '../../config';
---
<BaseLayout title="Documentation">
  <!-- Dark header band -->
  <section class="bg-charcoal relative overflow-hidden py-12 md:py-16">
    <div class="absolute inset-0" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-6 md:px-12">
      <h1 class="font-display text-3xl md:text-4xl font-bold text-[#f5f0ea]">Documentation</h1>
      <p class="text-[#f5f0ea]/50 mt-2 italic font-display">All the things you want to know about Wicket</p>
    </div>
  </section>

  <main class="bg-paper px-6 md:px-12 py-12 md:py-16">
    <div class="max-w-5xl mx-auto">
      <!-- Primary resources — large cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <!-- User Guide -->
        <a href={`${wicket.guideBaseUrl}/10.x/single.html`} target="_blank" rel="noopener"
           class="group p-8 border border-black/[0.06] rounded-lg bg-white hover:border-wicket-orange hover:shadow-[0_8px_32px_rgba(232,84,46,0.06)] hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-[#2a2320] to-[#3a3330] flex items-center justify-center text-2xl mb-4 text-wicket-orange">
            📖
          </div>
          <h2 class="font-display text-xl font-bold text-ink mb-2 group-hover:text-wicket-orange transition-colors">User Guide</h2>
          <p class="text-sm text-warm-mid leading-relaxed">200+ page guide covering models, behaviours, testing, and integration. Available for Wicket 10.x and 9.x.</p>
          <div class="mt-4 flex gap-3 text-xs font-medium">
            <span class="text-wicket-orange">10.x HTML</span>
            <span class="text-warm-light">·</span>
            <span class="text-warm-mid">10.x PDF</span>
            <span class="text-warm-light">·</span>
            <span class="text-warm-mid">9.x HTML</span>
          </div>
        </a>

        <!-- API Documentation -->
        <a href={`${wicket.javadocBaseUrl}/10.x/index.html`} target="_blank" rel="noopener"
           class="group p-8 border border-black/[0.06] rounded-lg bg-white hover:border-wicket-orange hover:shadow-[0_8px_32px_rgba(232,84,46,0.06)] hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-[#1a1a2a] to-[#2a2a3a] flex items-center justify-center text-2xl mb-4 text-[#6db3ce]">
            { }
          </div>
          <h2 class="font-display text-xl font-bold text-ink mb-2 group-hover:text-wicket-orange transition-colors">API Reference</h2>
          <p class="text-sm text-warm-mid leading-relaxed">Complete JavaDoc for all Wicket classes and methods. Your IDE downloads these automatically with Maven.</p>
          <div class="mt-4 flex gap-3 text-xs font-medium">
            <span class="text-wicket-orange">10.x JavaDoc</span>
            <span class="text-warm-light">·</span>
            <span class="text-warm-mid">9.x JavaDoc</span>
          </div>
        </a>
      </div>

      <!-- Secondary resources — smaller cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/docs/examples"
           class="group p-6 border border-black/[0.06] rounded-lg bg-white hover:border-wicket-orange hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#1a2a1a] to-[#2a3a2a] flex items-center justify-center text-lg mb-3 text-[#8fbc6f]">
            ▶
          </div>
          <h3 class="font-display text-base font-bold text-ink mb-1 group-hover:text-wicket-orange transition-colors">Examples</h3>
          <p class="text-xs text-warm-mid leading-relaxed">Browse examples and live demos</p>
        </a>

        <a href="/docs/books"
           class="group p-6 border border-black/[0.06] rounded-lg bg-white hover:border-wicket-orange hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#2a2320] to-[#3a3330] flex items-center justify-center text-lg mb-3 text-wicket-orange">
            📚
          </div>
          <h3 class="font-display text-base font-bold text-ink mb-1 group-hover:text-wicket-orange transition-colors">Books</h3>
          <p class="text-xs text-warm-mid leading-relaxed">Published books about Wicket</p>
        </a>

        <a href="/docs/migration"
           class="group p-6 border border-black/[0.06] rounded-lg bg-white hover:border-wicket-orange hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#1a1a2a] to-[#2a2a3a] flex items-center justify-center text-lg mb-3 text-[#6db3ce]">
            ↗
          </div>
          <h3 class="font-display text-base font-bold text-ink mb-1 group-hover:text-wicket-orange transition-colors">Migration</h3>
          <p class="text-xs text-warm-mid leading-relaxed">Upgrade between versions</p>
        </a>

        <a href={wicket.liveExamplesUrl} target="_blank" rel="noopener"
           class="group p-6 border border-black/[0.06] rounded-lg bg-white hover:border-wicket-orange hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#1a2a1a] to-[#2a3a2a] flex items-center justify-center text-lg mb-3 text-[#8fbc6f]">
            🌐
          </div>
          <h3 class="font-display text-base font-bold text-ink mb-1 group-hover:text-wicket-orange transition-colors">Live Demos</h3>
          <p class="text-xs text-warm-mid leading-relaxed">Try Wicket in your browser</p>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
