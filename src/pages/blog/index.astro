---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postsPerPage = 10;
const currentPosts = posts.slice(0, postsPerPage);

const tagColors: Record<string, string> = {
  release: 'bg-wicket-orange-glow text-wicket-orange',
  security: 'bg-[rgba(143,188,111,0.15)] text-[#5a8a3c]',
  community: 'bg-[rgba(109,179,206,0.15)] text-[#3a7a9a]',
};
---
<BaseLayout title="Blog">
  <main class="bg-paper">
    <div class="max-w-4xl mx-auto px-6 md:px-12 py-16">
      <h1 class="text-4xl font-bold text-ink mb-12">Blog</h1>
      <div class="space-y-8">
        {currentPosts.map((post) => {
          const dateStr = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
          const tag = post.data.tags?.[0] || 'community';
          return (
            <article class="border-b border-black/[0.06] pb-8">
              <div class="text-sm text-warm-light mb-1">{dateStr}</div>
              <div class="flex gap-2 mb-2">
                <span class:list={['text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded', tagColors[tag] || tagColors.community]}>
                  {tag}
                </span>
              </div>
              <h2 class="font-display text-xl font-bold">
                <a href={`/blog/${post.slug}`} class="text-ink hover:text-wicket-orange no-underline">{post.data.title}</a>
              </h2>
            </article>
          );
        })}
      </div>
    </div>
  </main>
</BaseLayout>
