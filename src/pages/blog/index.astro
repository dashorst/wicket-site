---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postsPerPage = 12;
const currentPosts = posts.slice(0, postsPerPage);

const tagColors: Record<string, string> = {
  release: 'bg-wicket-orange-glow text-wicket-orange',
  security: 'bg-[rgba(143,188,111,0.15)] text-[#5a8a3c]',
  community: 'bg-[rgba(109,179,206,0.15)] text-[#3a7a9a]',
};

// Group first 3 as "featured" (larger cards), rest as standard
const featured = currentPosts.slice(0, 3);
const rest = currentPosts.slice(3);
---
<BaseLayout title="Blog">
  <!-- Dark header band -->
  <section class="bg-charcoal relative overflow-hidden py-12 md:py-16">
    <div class="absolute inset-0" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-6 md:px-12">
      <h1 class="font-display text-3xl md:text-4xl font-bold text-[#f5f0ea]">Blog</h1>
      <p class="text-[#f5f0ea]/50 mt-2">News, releases, and updates from the Apache Wicket project</p>
    </div>
  </section>

  <main class="bg-paper px-6 md:px-12 py-12 md:py-16">
    <div class="max-w-5xl mx-auto">
      <!-- Featured posts (3-column cards) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {featured.map((post) => {
          const dateStr = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
          const tag = post.data.tags?.[0] || 'community';
          return (
            <article class="border border-black/[0.06] rounded-lg p-6 bg-white hover:border-wicket-orange hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(0,0,0,0.04)] transition-all">
              <div class="text-xs text-warm-light font-medium mb-2">{dateStr}</div>
              <span class:list={['inline-block text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded mb-3', tagColors[tag] || tagColors.community]}>
                {tag}
              </span>
              <h2 class="font-display text-lg font-bold leading-snug">
                <a href={`/blog/${post.slug}`} class="text-ink hover:text-wicket-orange no-underline">{post.data.title}</a>
              </h2>
            </article>
          );
        })}
      </div>

      <!-- Remaining posts (compact list with visual rhythm) -->
      {rest.length > 0 && (
        <div>
          <h2 class="text-[11px] tracking-[0.12em] uppercase font-semibold text-warm-light mb-6">Older Posts</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {rest.map((post) => {
              const dateStr = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
              const tag = post.data.tags?.[0] || 'community';
              return (
                <article class="flex items-start gap-4 p-4 rounded-lg hover:bg-paper-dim transition-colors">
                  <div class="shrink-0 w-16 text-right">
                    <div class="text-xs text-warm-light font-medium">{dateStr}</div>
                  </div>
                  <div class="border-l-2 border-black/[0.06] pl-4 flex-1">
                    <span class:list={['inline-block text-[9px] uppercase tracking-wider font-semibold px-1.5 py-0.5 rounded mb-1', tagColors[tag] || tagColors.community]}>
                      {tag}
                    </span>
                    <h3 class="text-sm font-semibold leading-snug">
                      <a href={`/blog/${post.slug}`} class="text-ink hover:text-wicket-orange no-underline">{post.data.title}</a>
                    </h3>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      )}

      <!-- View all link -->
      <div class="mt-8 pt-8 border-t border-black/[0.06] text-center">
        <p class="text-sm text-warm-mid">Showing {currentPosts.length} of {posts.length} posts</p>
      </div>
    </div>
  </main>
</BaseLayout>
