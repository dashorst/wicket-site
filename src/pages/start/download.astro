---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import { wicket } from '../../config';
---

<DefaultLayout
  title="Download Apache Wicket"
  subtitle="Get the most recent version of Wicket"
  preamble="Wicket is released as a source archive, convenience binaries, and through the Maven Central Repository. The most convenient way of using Wicket is through Maven or Gradle dependency management."
>

  <h2>Supported Versions</h2>
  <p>The following releases are actively supported by the Wicket team.</p>

  <div class="not-prose overflow-x-auto rounded-lg border border-black/[0.06] mb-4">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-paper-dim border-b border-black/[0.06]">
          <th class="px-4 py-3 text-left font-bold text-ink">Version</th>
          <th class="px-4 py-3 text-left font-bold text-ink">Latest Release</th>
          <th class="px-4 py-3 text-left font-bold text-ink">Status</th>
          <th class="px-4 py-3 text-left font-bold text-ink">Java</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-black/[0.04]">
        {wicket.versions.map((v) => (
          <tr class="hover:bg-paper-dim transition-colors">
            <td class="px-4 py-3 font-medium text-ink">Wicket {v.branch}</td>
            <td class="px-4 py-3 font-mono text-wicket-orange font-medium">{v.version}</td>
            <td class="px-4 py-3">
              {v.status === 'current, supported' ? (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">current</span>
              ) : v.status === 'supported' ? (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">supported</span>
              ) : (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">security fixes only</span>
              )}
            </td>
            <td class="px-4 py-3 font-mono text-warm-mid">{v.java}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    If your application is on an older branch, consider upgrading at your earliest convenience.
  </p>

  <hr />

  <h2>Using Maven</h2>
  <p>
    Add the following dependency to your <code>pom.xml</code> to use Wicket {wicket.version}:
  </p>

  <div class="not-prose bg-[#0f1419] rounded-lg p-6 font-mono text-[13px] text-[#abb2bf] border border-white/[0.06] mb-4 overflow-x-auto">
    <pre class="m-0 whitespace-pre">{`<dependency>
    <groupId>org.apache.wicket</groupId>
    <artifactId>wicket-core</artifactId>
    <version>${wicket.version}</version>
</dependency>`}</pre>
  </div>

  <h2>Using Gradle</h2>

  <div class="not-prose bg-[#0f1419] rounded-lg p-6 font-mono text-[13px] text-[#abb2bf] border border-white/[0.06] mb-4 overflow-x-auto">
    <pre class="m-0 whitespace-pre">{`implementation 'org.apache.wicket:wicket-core:${wicket.version}'`}</pre>
  </div>

  <hr />

  <h2>Manual Download</h2>
  <p>
    You can also download a binary or source distribution directly. Use the Apache mirror system
    to find the closest download location.
  </p>
  <ul>
    <li>
      <a
        href={`https://www.apache.org/dyn/closer.cgi/wicket/${wicket.version}`}
        target="_blank"
        rel="noopener"
      >
        Download Apache Wicket {wicket.version}
      </a>
    </li>
  </ul>

  <p>
    For older releases, visit the <a href="https://archive.apache.org/dist/wicket/" target="_blank" rel="noopener">Apache release archives</a>.
  </p>

  <hr />

  <h2>SNAPSHOT Repository</h2>
  <p>
    To use SNAPSHOT versions you must add the Apache snapshot repository to your <code>pom.xml</code>:
  </p>

  <div class="not-prose bg-[#0f1419] rounded-lg p-6 font-mono text-[13px] text-[#abb2bf] border border-white/[0.06] mb-4 overflow-x-auto">
    <pre class="m-0 whitespace-pre">{`<repository>
    <id>apache.snapshots</id>
    <name>Apache Development Snapshot Repository</name>
    <url>https://repository.apache.org/content/repositories/snapshots/</url>
    <releases>
        <enabled>false</enabled>
    </releases>
    <snapshots>
        <enabled>true</enabled>
    </snapshots>
</repository>`}</pre>
  </div>

  <p>
    <strong>Note:</strong> SNAPSHOT versions are development builds and should never be used in production.
    They may be deleted at any time.
  </p>

</DefaultLayout>
