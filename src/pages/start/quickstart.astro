---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import { wicket } from '../../config';

const archetypeGroupId = wicket.archetype.groupId;
const archetypeArtifactId = wicket.archetype.artifactId;
---

<DefaultLayout
  title="Create a Wicket Quickstart"
  subtitle="Up and running in seconds"
>
  <p>
    The Wicket Quickstart Wizard uses <a href="https://maven.apache.org">Apache Maven</a> to
    generate a starter project. Make sure Maven is installed and available on your
    <code>PATH</code> before you continue.
  </p>

  <h2>Quick Start Wizard</h2>
  <p>Fill in your project details below and copy the generated command line to your terminal.</p>

  <div class="not-prose bg-paper-dim rounded-lg border border-black/[0.06] p-6">
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-ink" for="groupId">Group ID</label>
        <input
          type="text"
          id="groupId"
          value="com.example"
          class="rounded border border-black/20 bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-wicket-orange/50"
          oninput="updateCommand()"
        />
        <span class="text-xs text-warm-mid">Your base Java package (e.g. com.example)</span>
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-ink" for="artifactId">Artifact ID</label>
        <input
          type="text"
          id="artifactId"
          value="myapp"
          class="rounded border border-black/20 bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-wicket-orange/50"
          oninput="updateCommand()"
        />
        <span class="text-xs text-warm-mid">Your project name (e.g. myapp)</span>
      </div>
      <div class="flex flex-col gap-1 sm:col-span-2">
        <label class="text-sm font-medium text-ink" for="version">Wicket Version</label>
        <select
          id="version"
          class="rounded border border-black/20 bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-wicket-orange/50 w-full sm:w-64"
          onchange="updateCommand()"
        >
          {wicket.versions.map((v) => (
            <option value={v.version} selected={v.version === wicket.version}>
              {v.version} ({v.branch} — {v.status})
            </option>
          ))}
        </select>
      </div>
    </div>

    <div class="mt-4 flex flex-col gap-1">
      <label class="text-sm font-medium text-ink" for="cmdLine">Generated command line</label>
      <textarea
        id="cmdLine"
        readonly
        rows="4"
        class="w-full rounded border border-black/20 bg-white px-3 py-2 font-mono text-xs text-ink focus:outline-none focus:ring-2 focus:ring-wicket-orange/50 resize-y"
        onfocus="this.select()"
      ></textarea>
    </div>

    <div class="mt-3 flex items-center gap-3">
      <button
        id="copyBtn"
        type="button"
        onclick="copyCommand()"
        class="rounded bg-wicket-orange px-4 py-2 text-sm font-medium text-white hover:bg-wicket-orange/90 focus:outline-none focus:ring-2 focus:ring-wicket-orange/50 transition-colors"
      >
        Copy to clipboard
      </button>
      <span id="copyFeedback" class="text-sm text-warm-mid opacity-0 transition-opacity duration-300">Copied!</span>
    </div>
  </div>

  <h2>Using the Generated Project</h2>
  <ol>
    <li>Paste the command into a terminal and press Enter to generate the project.</li>
    <li>Navigate into the generated project directory.</li>
    <li>Import the project into your IDE (see below).</li>
    <li>Run the <code>Start</code> class in <code>src/test/java</code>.</li>
    <li>Open <a href="http://localhost:8080" target="_blank" rel="noopener">http://localhost:8080</a> in your browser.</li>
  </ol>

  <h2>Importing into Your IDE</h2>
  <p>
    All major Java IDEs have native support for Maven projects — no plugins required.
  </p>

  <h3>Eclipse</h3>
  <p>
    Choose <strong>File &rarr; Import &rarr; Existing Maven Projects</strong> and point Eclipse
    at the folder where the quickstart was generated.
  </p>

  <h3>IntelliJ IDEA</h3>
  <p>
    Open the <code>pom.xml</code> file directly via <strong>File &rarr; Open</strong>.
    IntelliJ will recognise it as a Maven project and import it automatically.
  </p>

  <h3>NetBeans</h3>
  <p>
    Choose <strong>File &rarr; Open Project</strong> and navigate to the generated folder.
    NetBeans will detect the Maven project and open it like any other Java project.
  </p>
</DefaultLayout>

<script define:vars={{ archetypeGroupId, archetypeArtifactId }}>
  function updateCommand() {
    const groupId = document.getElementById('groupId').value;
    const artifactId = document.getElementById('artifactId').value;
    const version = document.getElementById('version').value;
    let cmd = `mvn archetype:generate -DarchetypeGroupId=${archetypeGroupId} -DarchetypeArtifactId=${archetypeArtifactId} -DarchetypeVersion=${version} -DgroupId=${groupId} -DartifactId=${artifactId}`;
    if (version.match(/SNAPSHOT$/)) {
      cmd += ' -DarchetypeRepository=https://repository.apache.org/content/repositories/snapshots/';
    } else {
      cmd += ' -DarchetypeRepository=https://repository.apache.org/';
    }
    cmd += ' -DinteractiveMode=false';
    document.getElementById('cmdLine').value = cmd;
  }

  function copyCommand() {
    const cmdLine = document.getElementById('cmdLine');
    navigator.clipboard.writeText(cmdLine.value).then(() => {
      const feedback = document.getElementById('copyFeedback');
      feedback.style.opacity = '1';
      setTimeout(() => { feedback.style.opacity = '0'; }, 2000);
    }).catch(() => {
      cmdLine.select();
      document.execCommand('copy');
    });
  }

  // Initialize command on page load
  updateCommand();
</script>
