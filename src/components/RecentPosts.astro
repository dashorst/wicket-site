---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posts = allPosts.slice(0, 3);

const tagColors: Record<string, string> = {
  release: 'bg-wicket-orange-glow text-wicket-orange',
  security: 'bg-[rgba(143,188,111,0.15)] text-[#5a8a3c]',
  community: 'bg-[rgba(109,179,206,0.15)] text-[#3a7a9a]',
};
---
<section class="bg-paper px-6 md:px-12 py-20">
  <div class="flex items-baseline justify-between mb-8">
    <div>
      <p class="text-[11px] tracking-[0.12em] uppercase font-semibold text-wicket-orange mb-3">Latest News</p>
      <h2 class="font-display text-4xl font-bold text-ink">From the Blog</h2>
    </div>
    <a href="/blog" class="text-sm font-medium text-wicket-orange hover:underline no-underline">View all posts →</a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {posts.map((post) => {
      const dateStr = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      const tag = post.data.tags?.[0] || 'community';
      return (
        <article class="border border-black/[0.06] rounded-lg p-6 bg-white hover:border-wicket-orange hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(0,0,0,0.04)] transition-all">
          <div class="text-xs text-warm-light font-medium mb-2">{dateStr}</div>
          <span class:list={['inline-block text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded mb-2.5', tagColors[tag] || tagColors.community]}>
            {tag}
          </span>
          <h4 class="font-display text-[17px] font-bold text-ink mb-2 leading-snug">
            <a href={`/blog/${post.slug}`} class="text-ink hover:text-wicket-orange no-underline">{post.data.title}</a>
          </h4>
        </article>
      );
    })}
  </div>
</section>
