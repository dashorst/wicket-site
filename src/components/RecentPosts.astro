---
const posts = [
  { date: 'December 21, 2025', tag: 'release', title: 'Apache Wicket 10.8.0 Released', excerpt: 'The Apache Wicket PMC is proud to announce Apache Wicket 10.8.0...', slug: '/blog/2025/12/21/wicket-10.8.0-released' },
  { date: 'December 19, 2025', tag: 'release', title: 'Apache Wicket 9.22.0 Released', excerpt: 'The Apache Wicket PMC announces the 9.22.0 maintenance release...', slug: '/blog/2025/12/19/wicket-9.22.0-released' },
  { date: 'September 30, 2025', tag: 'release', title: 'Apache Wicket 10.7.0 Released', excerpt: 'We are happy to announce the release of Apache Wicket 10.7.0...', slug: '/blog/2025/09/30/wicket-10.7.0-released' },
];

const tagColors: Record<string, string> = {
  release: 'bg-wicket-orange-glow text-wicket-orange',
  security: 'bg-[rgba(143,188,111,0.15)] text-[#5a8a3c]',
  community: 'bg-[rgba(109,179,206,0.15)] text-[#3a7a9a]',
};
---
<section class="bg-paper px-6 md:px-12 py-20">
  <div class="flex items-baseline justify-between mb-8">
    <div>
      <p class="text-[11px] tracking-[0.12em] uppercase font-semibold text-wicket-orange mb-3">Latest News</p>
      <h2 class="font-display text-4xl font-bold text-ink">From the Blog</h2>
    </div>
    <a href="/blog" class="text-sm font-medium text-wicket-orange hover:underline no-underline">View all posts →</a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {posts.map((post) => (
      <article class="border border-black/[0.06] rounded-lg p-6 bg-white hover:border-wicket-orange hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(0,0,0,0.04)] transition-all">
        <div class="text-xs text-warm-light font-medium mb-2">{post.date}</div>
        <span class:list={['inline-block text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded mb-2.5', tagColors[post.tag] || tagColors.release]}>
          {post.tag}
        </span>
        <h4 class="font-display text-[17px] font-bold text-ink mb-2 leading-snug">
          <a href={post.slug} class="text-ink hover:text-wicket-orange no-underline">{post.title}</a>
        </h4>
        <p class="text-[13px] text-warm-mid leading-relaxed">{post.excerpt}</p>
      </article>
    ))}
  </div>
</section>
