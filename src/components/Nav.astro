---
import { navigation } from '../config';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---
<nav class="bg-paper px-6 md:px-12 py-4 flex items-center border-b border-black/[0.06]">
  <a href="/" class="flex items-center gap-2.5 no-underline">
    <div class="w-7 h-7 bg-wicket-orange rounded flex items-center justify-center text-white font-bold text-base font-display">W</div>
    <span class="font-display font-bold text-lg text-ink">Apache Wicket</span>
  </a>

  <div class="hidden md:flex ml-auto gap-7 text-sm font-medium">
    {navigation.map((item) => (
      <a
        href={item.href}
        class:list={[
          'no-underline transition-colors',
          currentPath.startsWith(item.href) ? 'text-wicket-orange' : 'text-warm-mid hover:text-wicket-orange',
          item.external && 'text-warm-light',
        ]}
        {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {item.text}{item.external ? ' →' : ''}
      </a>
    ))}
  </div>

  <button
    id="mobile-menu-toggle"
    class="md:hidden ml-auto p-2 text-warm-mid"
    aria-label="Toggle navigation"
    aria-expanded="false"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
  </button>
</nav>

<div id="mobile-menu" class="hidden md:hidden bg-paper border-b border-black/[0.06] px-6 py-4">
  {navigation.map((item) => (
    <a
      href={item.href}
      class="block py-2 text-sm font-medium text-warm-mid hover:text-wicket-orange no-underline"
      {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      {item.text}{item.external ? ' →' : ''}
    </a>
  ))}
</div>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>
