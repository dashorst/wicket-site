---
const features = [
  {
    icon: '{ }',
    iconClass: 'bg-gradient-to-br from-[#2a2320] to-[#3a3330] text-wicket-orange',
    title: 'For Java devs, by Java devs',
    description: "No transpiler. No bundler. No framework-of-the-month. Write Java and HTML — the same tools you'll use next year, and the year after that.",
  },
  {
    icon: '🛡',
    iconClass: 'bg-gradient-to-br from-[#1a2a1a] to-[#2a3a2a] text-[#8fbc6f]',
    title: 'Secure by Default',
    description: 'Full Content Security Policy support without unsafe directives. Automatic nonce injection. XSS protection built into the framework, not bolted on.',
  },
  {
    icon: '↗',
    iconClass: 'bg-gradient-to-br from-[#1a1a2a] to-[#2a2a3a] text-[#6db3ce]',
    title: 'Scales with your ambition',
    description: "From prototype to millions of lines of code. Java's packages, classes, and dependency injection are your architecture — no framework-specific scaffolding required.",
  },
];
---
<section class="bg-paper px-6 md:px-12 py-20">
  <p class="text-[11px] tracking-[0.12em] uppercase font-semibold text-wicket-orange mb-3">Why Wicket</p>
  <h2 class="font-display text-4xl font-bold text-ink mb-12 leading-tight">Crafted for the long run</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
    {features.map((feature) => (
      <div class="p-8 border border-black/[0.06] rounded-lg bg-white hover:border-wicket-orange hover:shadow-[0_8px_32px_rgba(232,84,46,0.06)] hover:-translate-y-0.5 transition-all">
        <div class:list={['w-10 h-10 rounded-lg mb-4 flex items-center justify-center text-lg', feature.iconClass]}>
          {feature.icon}
        </div>
        <h3 class="font-display text-xl font-bold text-ink mb-2">{feature.title}</h3>
        <p class="text-sm text-warm-mid leading-relaxed">{feature.description}</p>
      </div>
    ))}
  </div>
</section>
