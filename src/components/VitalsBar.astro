---
import { wicket } from '../config';

const released = new Date(wicket.released);
const releasedStr = released.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---
<section class="bg-charcoal px-6 md:px-12 py-10 flex flex-wrap justify-center gap-12 md:gap-16">
  <div class="text-center">
    <div class="font-display text-3xl font-black text-[#f5f0ea]">{wicket.version}</div>
    <div class="text-[11px] tracking-wider uppercase font-semibold text-[#f5f0ea]/35 mt-1">Latest Release</div>
  </div>
  <div class="text-center">
    <div class="font-display text-3xl font-black text-wicket-orange">{releasedStr}</div>
    <div class="text-[11px] tracking-wider uppercase font-semibold text-[#f5f0ea]/35 mt-1">Released</div>
  </div>
  <div class="text-center">
    <div class="font-display text-3xl font-black text-[#f5f0ea]">Java {wicket.javaBaseline}+</div>
    <div class="text-[11px] tracking-wider uppercase font-semibold text-[#f5f0ea]/35 mt-1">Baseline</div>
  </div>
  <div class="text-center">
    <div class="font-display text-3xl font-black text-wicket-orange">Jakarta EE</div>
    <div class="text-[11px] tracking-wider uppercase font-semibold text-[#f5f0ea]/35 mt-1">Compatible</div>
  </div>
</section>
