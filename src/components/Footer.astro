---
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Project',
    links: [
      { text: 'Get Started', href: '/start/quickstart' },
      { text: 'Documentation', href: '/docs' },
      { text: 'Examples', href: '/docs/examples' },
      { text: 'Download', href: '/start/download' },
      { text: 'Migration Guide', href: '/docs/migration' },
    ],
  },
  {
    title: 'Community',
    links: [
      { text: 'Mailing Lists', href: '/community#mailing-lists' },
      { text: 'Chat', href: '/community#chat' },
      { text: 'Contributing', href: '/community/contributing' },
      { text: 'Who Uses Wicket', href: '/community/who-uses-wicket' },
      { text: 'Blog', href: '/blog' },
    ],
  },
  {
    title: 'Apache',
    links: [
      { text: 'Apache Home', href: 'https://www.apache.org/' },
      { text: 'License', href: 'https://www.apache.org/licenses/' },
      { text: 'Sponsorship', href: 'https://www.apache.org/foundation/sponsorship.html' },
      { text: 'Thanks', href: 'https://www.apache.org/foundation/thanks.html' },
      { text: 'Security', href: 'https://www.apache.org/security/' },
      { text: 'Privacy', href: 'https://privacy.apache.org/policies/privacy-policy-public.html' },
    ],
  },
  {
    title: 'Source',
    links: [
      { text: 'GitHub', href: 'https://github.com/apache/wicket' },
      { text: 'Issue Tracker', href: 'https://issues.apache.org/jira/browse/WICKET' },
      { text: 'CI / Jenkins', href: 'https://ci-builds.apache.org/job/Wicket/' },
      { text: 'DOAP', href: '/doap.rdf' },
    ],
  },
];
---
<footer class="bg-ink px-6 md:px-12 py-12 text-xs">
  <div class="flex flex-wrap justify-between gap-8 mb-8 pb-8 border-b border-white/[0.06]">
    {columns.map((col) => (
      <div>
        <h4 class="font-display text-[13px] font-semibold text-white/70 mb-3">{col.title}</h4>
        {col.links.map((link) => (
          <a href={link.href} class="block py-0.5 text-white/35 hover:text-wicket-orange no-underline transition-colors">
            {link.text}
          </a>
        ))}
      </div>
    ))}
  </div>
  <div class="text-[11px] text-white/25 leading-relaxed">
    Copyright &copy; {year} The Apache Software Foundation. Apache Wicket,
    Wicket, Apache, the Apache oak leaf logo, and the Apache Wicket project
    logo are trademarks of The Apache Software Foundation. All other marks
    mentioned may be trademarks or registered trademarks of their respective
    owners.
    <br />
    <a
      href="https://events.apache.org/"
      class="inline-block mt-4 opacity-50 hover:opacity-80 transition-opacity"
    >
      <img
        src="https://www.apache.org/events/current-event-234x60.png"
        alt="ASF Current Event"
        class="h-10"
        loading="lazy"
        onerror="this.parentElement.style.display='none'"
      />
    </a>
  </div>
</footer>
