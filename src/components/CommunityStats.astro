---
const currentYear = new Date().getFullYear();
const yearsInProduction = currentYear - 2004;
---
<section class="bg-paper-dim px-6 md:px-12 py-16 text-center border-y border-black/[0.04]">
  <p class="text-[11px] tracking-[0.12em] uppercase font-semibold text-wicket-orange mb-6">The Wicket Community</p>
  <div class="flex flex-wrap justify-center gap-12 md:gap-16 mb-6">
    <div>
      <div class="font-display text-4xl font-black text-ink">860+</div>
      <div class="text-xs tracking-wider uppercase font-semibold text-warm-light mt-1">GitHub Stars</div>
    </div>
    <div>
      <div class="font-display text-4xl font-black text-wicket-orange">2.1M+</div>
      <div class="text-xs tracking-wider uppercase font-semibold text-warm-light mt-1">Maven Downloads</div>
    </div>
    <div>
      <div class="font-display text-4xl font-black text-ink">{yearsInProduction}</div>
      <div class="text-xs tracking-wider uppercase font-semibold text-warm-light mt-1">Years in Production</div>
    </div>
    <div>
      <div class="font-display text-4xl font-black text-wicket-orange">10</div>
      <div class="text-xs tracking-wider uppercase font-semibold text-warm-light mt-1">Major Versions</div>
    </div>
  </div>
  <a href="/community/who-uses-wicket" class="text-sm font-medium text-wicket-orange hover:underline no-underline">
    See who's building with Wicket →
  </a>
</section>
